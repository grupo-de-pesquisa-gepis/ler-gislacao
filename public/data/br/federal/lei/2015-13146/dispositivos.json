    "rubrica": null,
    "pai": "lbi_art1",
    "temas": [
      "Direito e Não Discriminação"
    ],
    "versoes": [
      {
        "texto": "Esta Lei tem como base a Convenção sobre os Direitos das Pessoas com Deficiência e seu Protocolo Facultativo, ratificados pelo Congresso Nacional por meio do Decreto Legislativo nº 186, de 9 de julho de 2008, em conformidade com o procedimento do § 3º do art. 5º da Constituição da República Federativa do Brasil, em vigor para o Brasil, no plano jurídico externo, desde 31 de agosto de 2008, e promulgados pelo Decreto nº 6.949, de 25 de agosto de 2009, data de início de sua vigência no plano interno.",
        "vigenteDesde": "2015-07-06",
        "vigenteAte": null,
        "evento": "publicacao-original",
        "origem": null,
        "vigenciaConfirmada": true,
        "capturadoEm": "2026-09-22",
        "fonte": "planalto"
      }
    ],
