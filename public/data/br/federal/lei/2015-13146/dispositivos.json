    "pai": "lbi_art4",
    "temas": [
      "Direito e Não Discriminação"
    ],
    "versoes": [
      {
        "texto": "Considera-se discriminação em razão da deficiência toda forma de distinção, restrição ou exclusão, por ação ou omissão, que tenha o propósito ou o efeito de prejudicar, impedir ou anular o reconhecimento ou o exercício dos direitos e das liberdades fundamentais de pessoa com deficiência, incluindo a recusa de adaptações razoáveis e de fornecimento de tecnologias assistivas.",
        "vigenteDesde": "2015-07-06",
        "vigenteAte": null,
        "evento": "publicacao-original",
        "origem": null,
        "vigenciaConfirmada": true,
