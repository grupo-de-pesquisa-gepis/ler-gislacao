  {
    "id": "dec7611_art2_par1",
    "tipo": "paragrafo",
    "rotulo": "§ 1º",
    "rubrica": null,
    "pai": "dec7611_art2",
    "temas": [
      "AEE"
    ],
    "versoes": [
      {
        "texto": "Para fins deste Decreto, aos serviços de apoio especializado denominam-se atendimento educacional especializado, compreendido como o conjunto de atividades, recursos de acessibilidade e pedagógicos organizados institucional e continuamente, prestado de forma suplementar à formação de estudantes com deficiência e transtornos globais do desenvolvimento, ou de forma complementar à formação de estudantes com altas habilidades ou superdotação.",
        "vigenteDesde": "2015-07-06",
        "vigenteAte": null,
        "evento": "publicacao-original",
        "origem": null,
        "vigenciaConfirmada": true,
        "capturadoEm": "2026-09-22",
        "fonte": "planalto"
      }
    ],
    "observacoes": []
  },
  {
