      "AEE"
    ],
    "versoes": [
      {
        "texto": "O atendimento educacional especializado deve integrar a proposta pedagógica da escola, envolver a participação da família para garantir pleno acesso e articulação com os demais serviços de educação e da saúde, assistência social e direitos humanos.",
        "vigenteDesde": "2015-07-06",
        "vigenteAte": null,
        "evento": "publicacao-original",
        "origem": null,
        "vigenciaConfirmada": true,
        "capturadoEm": "2026-09-22",
        "fonte": "planalto"
      }
    ],
